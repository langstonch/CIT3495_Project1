# Copy to .env and replace every placeholder before a shared or graded run.
# Compose reads this file for ${VAR} substitution. .env is git-ignored.

# Shared contract names.
MYSQL_HOST=mysql
MYSQL_DATABASE=analytics_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_root_password
MONGO_URI=mongodb://mongo:27017/analytics_db
JWT_SECRET=super_secret_jwt_signing_key
AUTH_URL=http://auth:5000

# Least-privilege MySQL accounts created by mysql/init.sh.
# The services do not log in as MYSQL_USER. Each role has its own account:
#   auth       SELECT, INSERT on users
#   enterdata  INSERT on measurements
#   analytics  SELECT on measurements
AUTH_DB_PASSWORD=change_this_password
ENTERDATA_DB_PASSWORD=change_this_password
ANALYTICS_DB_PASSWORD=change_this_password

# First auth user, seeded on auth startup when the users table has no match.
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_password

# Analytics job period (seconds). Clamped to 5-300 by the job.
ANALYTICS_INTERVAL_SECONDS=30
